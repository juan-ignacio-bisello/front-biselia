# Configuración de WhatsApp
# Número de teléfono en formato internacional sin el '+' (ej. 5491123456789)
VITE_WHATSAPP_NUMBER=

# (Opcional, solo desarrollo) URL del endpoint de contacto.
# En producción se usa /api/contact (Cloudflare Pages Function). Ej. para usar el backend Express local:
# VITE_API_URL=http://localhost:3001/api/contact
